{
  "manifest_version": 3,
  "name": "ScoutBuddy",
  "version": "1.0",

  "description": "Provides Scouting Data and Help for the FIRST Robotics Competition",

  "icons": {
    "48": "image/scoutingBuddyLogo.png",
    "96": "image/scoutingBuddyLogo.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "action": {
    "default_title": "ScoutBuddy",
    "default_icon": "image/scoutingBuddyLogo.png",
    "default_popup": "scoutinfo.html"
  },

  "host_permissions": [
    "https://www.thebluealliance.com/*",
    "https://i.imgur.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["robot/*.jpg"],
      "matches": ["*://*/*"]
    }
  ]
}